# Fedora 40 container for Tauri GUI build
# Provides glib-2.0 >= 2.70 required by Tauri 2.0
FROM fedora:40

# Install system dependencies
RUN dnf update -y && dnf install -y \
    # Rust toolchain
    rust cargo \
    # Node.js and npm
    nodejs npm \
    # GUI development libraries (newer versions)
    gtk3-devel \
    glib2-devel \
    webkit2gtk3-devel \
    webkit2gtk4.0-devel \
    librsvg2-devel \
    libappindicator-gtk3-devel \
    # Build tools
    gcc-c++ \
    pkgconfig \
    openssl-devel \
    # Additional dependencies
    at-spi2-atk-devel \
    atk-devel \
    cairo-devel \
    gdk-pixbuf2-devel \
    pango-devel \
    && dnf clean all

# Install Tauri CLI
RUN cargo install tauri-cli@2.8.1

# Set working directory
WORKDIR /workspace

# Copy source code
COPY . .

# Install frontend dependencies
RUN npm install

# Build the complete Tauri application
RUN npm run tauri build

# The binary will be in src-tauri/target/release/bundle/rpm/ or src-tauri/target/release/