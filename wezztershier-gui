#!/bin/bash
# Wezztershier Web GUI Launcher
# Part of the wezztershier-gui package

set -e

# Configuration
GUI_PORT=8080
WEB_DIR="$HOME/.local/share/wezztershier-gui"
HTML_FILE="$WEB_DIR/index.html"

# Create web directory
mkdir -p "$WEB_DIR"

# Create the HTML interface if it doesn't exist
if [ ! -f "$HTML_FILE" ]; then
    cat > "$HTML_FILE" << 'EOF'
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🎨 Wezztershier - WezTerm Configuration GUI</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #333;
            min-height: 100vh;
        }

        .header {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            padding: 1rem 2rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
            color: white;
            text-align: center;
        }

        .header h1 { font-size: 1.8rem; margin-bottom: 0.5rem; }
        .header p { opacity: 0.9; }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            height: calc(100vh - 120px);
        }

        .panel {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 12px;
            padding: 2rem;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-direction: column;
        }

        .panel h2 {
            color: #333;
            margin-bottom: 1.5rem;
            font-size: 1.3rem;
            border-bottom: 2px solid #667eea;
            padding-bottom: 0.5rem;
        }

        .config-input {
            flex: 1;
            width: 100%;
            font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Roboto Mono', monospace;
            font-size: 0.9rem;
            line-height: 1.5;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 1rem;
            resize: none;
            background: #f8f9fa;
        }

        .config-input:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .buttons {
            margin-top: 1rem;
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .btn {
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-primary {
            background: #667eea;
            color: white;
        }

        .btn-primary:hover {
            background: #5a67d8;
            transform: translateY(-1px);
        }

        .btn-secondary {
            background: #e2e8f0;
            color: #4a5568;
        }

        .btn-secondary:hover {
            background: #cbd5e0;
        }

        .preview {
            flex: 1;
            background: #1a202c;
            color: #e2e8f0;
            padding: 1.5rem;
            border-radius: 8px;
            font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Roboto Mono', monospace;
            font-size: 0.85rem;
            line-height: 1.6;
            white-space: pre-wrap;
            overflow-y: auto;
            border: 1px solid #2d3748;
        }

        .sample-configs {
            margin-bottom: 1rem;
        }

        .sample-btn {
            background: #48bb78;
            color: white;
            margin-right: 0.5rem;
            margin-bottom: 0.5rem;
            font-size: 0.8rem;
            padding: 0.5rem 1rem;
        }

        .sample-btn:hover {
            background: #38a169;
        }

        .status {
            margin-top: 1rem;
            padding: 0.75rem;
            border-radius: 6px;
            font-size: 0.9rem;
        }

        .status.success {
            background: #c6f6d5;
            color: #22543d;
            border: 1px solid #9ae6b4;
        }

        .status.error {
            background: #fed7d7;
            color: #c53030;
            border: 1px solid #feb2b2;
        }

        @media (max-width: 768px) {
            .container {
                grid-template-columns: 1fr;
                gap: 1rem;
                height: auto;
            }
            
            .panel {
                padding: 1rem;
            }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>🎨 Wezztershier Configuration GUI</h1>
        <p>Visual interface for configuring WezTerm with decorator annotations</p>
    </div>

    <div class="container">
        <div class="panel">
            <h2>📝 WezTerm Configuration</h2>
            
            <div class="sample-configs">
                <button class="btn sample-btn" onclick="loadSample('basic')">📄 Basic Sample</button>
                <button class="btn sample-btn" onclick="loadSample('colors')">🎨 Color Sample</button>
                <button class="btn sample-btn" onclick="loadSample('advanced')">⚡ Advanced Sample</button>
            </div>
            
            <textarea 
                id="config-input" 
                class="config-input" 
                placeholder="Paste your WezTerm Lua configuration with @ui annotations here, or click a sample button above to get started..."
            ></textarea>
            
            <div class="buttons">
                <button class="btn btn-primary" onclick="processConfig()">
                    🎨 Generate Interface
                </button>
                <button class="btn btn-secondary" onclick="clearConfig()">
                    🗑️ Clear
                </button>
                <button class="btn btn-secondary" onclick="downloadConfig()">
                    ⬇️ Download
                </button>
                <a href="#" class="btn btn-secondary" onclick="showHelp(); return false;">
                    ❓ Help
                </a>
            </div>
            
            <div id="status"></div>
        </div>

        <div class="panel">
            <h2>👀 Live Preview</h2>
            <div id="preview" class="preview">Welcome to Wezztershier! 🎨

Click on one of the sample buttons to load an example configuration,
or paste your own WezTerm Lua config with @ui annotations.

Supported annotations:
• @ui: slider(min=X, max=Y, step=Z) type=int|float
• @ui: select(options=A,B,C) type=string  
• @ui: color_picker(format=hex|rgb|hsl) type=color
• @ui: theme_selector(themes=builtin) type=string

Example:
-- @ui: slider(min=8, max=72, step=1) type=int
config.font_size = 14</div>
        </div>
    </div>

    <script>
        const samples = {
            basic: `-- Basic WezTerm configuration with UI annotations
-- @ui: slider(min=8, max=72, step=1) type=int
config.font_size = 14

-- @ui: select(options=Block,Underline,Bar) type=string  
config.default_cursor_style = "Block"

-- @ui: slider(min=0.1, max=1.0, step=0.1) type=float
config.window_background_opacity = 0.95`,

            colors: `-- WezTerm color configuration with UI controls
-- @ui: color_picker(format=hex, alpha=false) type=color
config.colors = {
    background = "#282a36",
    
    -- @ui: color_picker(format=hex, alpha=false) type=color
    foreground = "#f8f8f2",
    
    -- @ui: color_picker(format=hex, alpha=false) type=color
    cursor_bg = "#50fa7b",
}

-- @ui: theme_selector(themes=builtin, filter=all) type=string
config.color_scheme = "Dracula"`,

            advanced: `-- Advanced WezTerm configuration
-- @ui: slider(min=8, max=72, step=1) type=int
config.font_size = 16

-- @ui: select(options=FiraCode,JetBrains,Cascadia) type=string
config.font_family = "FiraCode Nerd Font"

-- @ui: theme_selector(themes=builtin, filter=all) type=string
config.color_scheme = "Tokyo Night"

-- @ui: slider(min=0.1, max=1.0, step=0.05) type=float
config.window_background_opacity = 0.9

-- @ui: select(options=bottom,top,hidden) type=string
config.tab_bar_at_bottom = "bottom"

-- Window padding
-- @ui: slider(min=0, max=20, step=1) type=int
config.window_padding = {
    left = 8,
    right = 8,
    top = 8,
    bottom = 8,
}`
        };

        function loadSample(type) {
            const textarea = document.getElementById('config-input');
            textarea.value = samples[type] || samples.basic;
            showStatus('Sample configuration loaded! Click "Generate Interface" to process.', 'success');
        }

        function clearConfig() {
            document.getElementById('config-input').value = '';
            document.getElementById('preview').textContent = 'Configuration cleared. Load a sample or paste your own config.';
            clearStatus();
        }

        function processConfig() {
            const config = document.getElementById('config-input').value;
            const preview = document.getElementById('preview');
            
            if (!config.trim()) {
                showStatus('Please enter or load a configuration first.', 'error');
                return;
            }

            // Simulate processing with the CLI
            preview.textContent = `Configuration processed! 🎉

Generated Interface Elements:
${analyzeConfig(config)}

Processed Configuration:
${config}

💡 In a full implementation, this would:
1. Call 'wezztershier parse' on your config
2. Generate interactive widgets for each @ui annotation
3. Allow real-time editing with live preview
4. Export the final configuration

Your configuration is ready to use with WezTerm!`;

            showStatus('Configuration processed successfully!', 'success');
        }

        function analyzeConfig(config) {
            const lines = config.split('\n');
            const widgets = [];
            
            for (const line of lines) {
                if (line.includes('@ui:')) {
                    const match = line.match(/@ui:\s*(\w+)/);
                    if (match) {
                        widgets.push(`• ${match[1]} widget detected`);
                    }
                }
            }
            
            return widgets.length ? widgets.join('\n') : '• No @ui annotations detected';
        }

        function downloadConfig() {
            const config = document.getElementById('config-input').value;
            if (!config.trim()) {
                showStatus('Please enter a configuration to download.', 'error');
                return;
            }
            
            const blob = new Blob([config], { type: 'text/plain' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'wezterm.lua';
            document.body.appendChild(a);
            a.click();
            window.URL.revokeObjectURL(url);
            document.body.removeChild(a);
            
            showStatus('Configuration downloaded as wezterm.lua', 'success');
        }

        function showHelp() {
            const preview = document.getElementById('preview');
            preview.textContent = `Wezztershier Help 📖

DECORATOR ANNOTATIONS:
Use these annotations above your WezTerm configuration lines:

🔢 SLIDERS:
-- @ui: slider(min=8, max=72, step=1) type=int
config.font_size = 14

-- @ui: slider(min=0.1, max=1.0, step=0.1) type=float  
config.window_background_opacity = 0.95

📋 SELECT DROPDOWNS:
-- @ui: select(options=Block,Underline,Bar) type=string
config.default_cursor_style = "Block"

-- @ui: select(options=bottom,top,hidden) type=string
config.tab_bar_at_bottom = "bottom"

🎨 COLOR PICKERS:
-- @ui: color_picker(format=hex, alpha=false) type=color
config.colors.background = "#282a36"

-- @ui: color_picker(format=rgb, alpha=true) type=color  
config.colors.foreground = "rgb(248, 248, 242)"

🎭 THEME SELECTORS:
-- @ui: theme_selector(themes=builtin, filter=all) type=string
config.color_scheme = "Dracula"

HOW TO USE:
1. Add @ui annotations above your config variables
2. Load or paste your annotated config
3. Click "Generate Interface" to process
4. Download the processed configuration
5. Use with WezTerm: place in ~/.config/wezterm/wezterm.lua

For more help, visit: https://repos.musicsian.com`;

            showStatus('Help information displayed in preview panel.', 'success');
        }

        function showStatus(message, type) {
            const statusDiv = document.getElementById('status');
            statusDiv.textContent = message;
            statusDiv.className = `status ${type}`;
        }

        function clearStatus() {
            const statusDiv = document.getElementById('status');
            statusDiv.textContent = '';
            statusDiv.className = '';
        }

        // Load basic sample on page load
        window.onload = function() {
            loadSample('basic');
        };
    </script>
</body>
</html>
EOF
fi

echo "🎨 Starting Wezztershier Web GUI..."
echo "   Opening at: http://localhost:$GUI_PORT"
echo "   Web files:  $WEB_DIR"
echo ""
echo "   Press Ctrl+C to stop the server"
echo "   Or close this terminal window"
echo ""

# Start the web server
cd "$WEB_DIR"

# Try different Python versions
if command -v python3 >/dev/null 2>&1; then
    python3 -m http.server $GUI_PORT 2>/dev/null
elif command -v python >/dev/null 2>&1; then
    python -m SimpleHTTPServer $GUI_PORT 2>/dev/null
else
    echo "❌ Error: Python not available"
    echo ""
    echo "📂 Manual option: Open this file in your browser:"
    echo "   file://$HTML_FILE"
    echo ""
    echo "💡 Or install Python and run this script again"
    exit 1
fi