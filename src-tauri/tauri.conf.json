{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Wezztershier",
  "version": "0.1.0",
  "identifier": "com.wezztershier.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Wezztershier - WezTerm Configuration",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: 'unsafe-inline' 'unsafe-eval'; img-src 'self' tauri: asset: https: data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "copyright": "© 2024 espadonne (mfw)",
    "shortDescription": "WezTerm Configuration GUI",
    "longDescription": "A beautiful GUI for configuring WezTerm terminal emulator settings through decorator annotations."
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "window-state": {
      "filename": "window-state.json"
    }
  }
}